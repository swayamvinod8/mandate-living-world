# Copy to web/.env.local and fill in. Never commit .env.local.

# Public (safe in the browser)
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_NPC_AUTHORITY=

# Server only
SOLANA_RPC_URL=https://api.devnet.solana.com
ANTHROPIC_API_KEY=
RECAP_MODEL=claude-sonnet-5-5

# true until the program is deployed and web/lib/idl/mandate.json exists
RECAP_USE_MOCK=true
